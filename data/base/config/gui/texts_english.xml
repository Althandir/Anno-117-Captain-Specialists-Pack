  <!-- Specialist CaptainMoreSlots-L -->
  <Group>
    <ModOp Add="/TextExport/Texts">
      <!-- Title -->
      <Text>
          <Text>Iacobus Garibaldus, Imperial Purveyor</Text>
          <LineId>1600000488</LineId> <!-- <GUID>1600000488</GUID> -->
      </Text>
      <!-- Description -->
      <Text>
          <Text>“All roads lead to Rome. And if one of those roads goes through the sea, then I'll take it!”&#xD;Optimizes your ship to deliver massive amounts of Talentum to their destinations. &#xD;(Captains-Pack)</Text>
          <LineId>1600000489</LineId> 
      </Text>
      <!-- Boosted Hint -->
      <Text>
          <Text>He loves being deployed in busy parts of the world. (Own 24x Trade Routes)</Text>
          <LineId>1600000490</LineId> 
      </Text>
    </ModOp>
  </Group>

  <!-- Specialist CaptainLessSlots-L -->
  <Group>
    <ModOp Add="/TextExport/Texts">
      <!-- Title -->
      <Text>
          <Text>Virodanna Cautia, Overcautious Captain</Text>
          <LineId>1600000491</LineId> <!-- <GUID>1600000491</GUID> -->
      </Text>
      <!-- Description -->
      <Text>
          <Text>“Do we really have everything on board? Don't forget the fourth spare sail!”&#xD;Fills cargo spaces with additional maintenance supplies to avoid putting herself and her crew in danger. &#xD;(Captains-Pack)</Text>
          <LineId>1600000492</LineId> 
      </Text>
      <!-- Boosted Hint -->
      <Text>
          <Text>She hates unfamiliar places. (16 Islands discovered)</Text>
          <LineId>1600000493</LineId> 
      </Text>
    </ModOp>
