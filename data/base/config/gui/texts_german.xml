    <ModOp Add="/TextExport/Texts">
      <!-- Title -->
      <Text>
          <Text>Iacobus Garibaldus, Kaiserlicher Lieferant</Text>
          <LineId>1600000488</LineId> <!-- <GUID>1600000488</GUID> -->
      </Text>
      <!-- Description -->
      <Text>
          <Text>"Alle Wege führen nach Rom. Und wenn ein Weg durchs Meer führt, dann gehe ich diesen!"&#xD;Optimiert dein Schiff um Massen von Talentum zu ihren Bestimmungsorten zu liefern. &#xD;(Captains-Pack)</Text>
          <LineId>1600000489</LineId> 
      </Text>
      <!-- Boosted Hint -->
      <Text>
          <Text>Liebt es in viel befahrenen Regionen eingesetzt zu werden. (Besitze 24x Handelsrouten)</Text>
          <LineId>1600000490</LineId> 
      </Text>
    </ModOp>
  </Group>
  
  <!-- Specialist CaptainLessSlots-L -->
